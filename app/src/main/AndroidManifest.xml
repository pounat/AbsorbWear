<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Network access for direct ABS server calls when the phone isn't reachable. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Media playback foreground service for standalone download/play on watch. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Health Services tells the app when the wearer falls asleep. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Lets us find the system media output picker (Wear OS 5) and the
         Bluetooth settings page it falls back to, so a play attempt with no
         headphones connected can send the user straight there. -->
    <queries>
        <intent>
            <action android:name="com.android.settings.panel.action.MEDIA_OUTPUT" />
        </intent>
        <intent>
            <action android:name="android.settings.BLUETOOTH_SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".AbsorbWearApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Marks the app as standalone so it can run/install on Wear OS
             devices that aren't paired with a phone running Absorb. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.AbsorbWear.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Wear OS 6 launches this instead of its own Media Controls when
                 the phone's Absorb starts playing and media auto-launch is on
                 for the app. The activity opens on the phone-remote screen. -->
            <intent-filter>
                <action android:name="com.google.wear.services.media.action.REMOTE_MEDIA_ACTIVITY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- The phone opens this through Wear OS (RemoteActivityHelper)
                 when it starts playing and "Open when phone plays" is on.
                 The host is the applicationId so dev and regular builds on
                 one watch each answer only their own phone app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="absorbwear"
                    android:host="${applicationId}"
                    android:path="/phone" />
            </intent-filter>
        </activity>

        <!-- Receives credential payloads pushed from the phone over the
             Wearable Data Layer. Filter on the absorb-auth path so we only
             wake up when the phone publishes a fresh /absorb/auth DataItem. -->
        <service
            android:name=".sync.CredentialSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/absorb/auth" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/absorb/auth" />
            </intent-filter>
        </service>

        <!-- Woken by Health Services with the wearer's activity state, so a
             book can pause when they fall asleep. -->
        <service
            android:name=".sleep.SleepListenerService"
            android:exported="true"
            android:permission="com.google.android.wearable.healthservices.permission.PASSIVE_DATA_BINDING" />

        <!-- Handles play/pause/skip taps from the cold-start now-playing
             notification. Not exported — only our own PendingIntents fire it. -->
        <receiver
            android:name=".player.MediaCommandReceiver"
            android:exported="false" />

        <!-- Watch-side MediaSession host. Its presence makes Wear OS surface
             AbsorbWear's own controls (and the ongoing activity that opens
             us) instead of the generic system media template. -->
        <service
            android:name=".player.AbsorbMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <!-- The legacy browser action is how Wear OS recognises a
                     package's watch app as its media app, which is what keeps
                     the system from proxying the phone's session separately. -->
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Keeps books on the watch: Media3's download manager filling the
             media cache, as a foreground service while it runs. -->
        <service
            android:name=".download.AbsorbDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="androidx.media3.exoplayer.downloadService.action.RESTART" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Pulls a narrated EPUB's audio files out of the EPUB on an
             Audiobookshelf server, as a foreground service so the pull
             survives the screen going dark. -->
        <service
            android:name=".download.NarrationPullService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The watch face complication: the playing book and how far
             through it is, on the watch or the phone. -->
        <service
            android:name=".complication.NowPlayingComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_wave"
            android:label="@string/complication_now_playing"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT,LONG_TEXT,SMALL_IMAGE,MONOCHROMATIC_IMAGE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <!-- A play/pause button on the watch face: toggles the playing
             book, on the watch or the phone, without opening the app. -->
        <service
            android:name=".complication.PlayPauseComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_play"
            android:label="@string/complication_play_pause"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="MONOCHROMATIC_IMAGE,SMALL_IMAGE,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <!-- Receives playback state snapshots pushed by the phone every
             time the HomeWidgetService updates. -->
        <service
            android:name=".sync.PlayerSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/absorb/player/state" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/absorb/player/chapters" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/absorb/player/volume" />
            </intent-filter>
        </service>
    </application>

</manifest>
